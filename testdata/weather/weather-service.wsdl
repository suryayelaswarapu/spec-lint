<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fictional weather SOAP service used as a clean document/literal example.
  example.com is reserved for documentation (RFC 2606); no real endpoint is called.
-->
<wsdl:definitions name="WeatherService"
    targetNamespace="http://example.com/weather/v1"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://example.com/weather/v1">

  <wsdl:documentation>Current conditions and multi-day forecasts by city or coordinates.</wsdl:documentation>

  <wsdl:types>
    <xs:schema targetNamespace="http://example.com/weather/v1" elementFormDefault="qualified">

      <xs:simpleType name="Units">
        <xs:annotation><xs:documentation>Measurement system for temperatures and wind.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="metric"/>
          <xs:enumeration value="imperial"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:simpleType name="Latitude">
        <xs:restriction base="xs:decimal">
          <xs:minInclusive value="-90"/>
          <xs:maxInclusive value="90"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:simpleType name="Longitude">
        <xs:restriction base="xs:decimal">
          <xs:minInclusive value="-180"/>
          <xs:maxInclusive value="180"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:simpleType name="StationId">
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z]{4}"/>
        </xs:restriction>
      </xs:simpleType>

      <xs:complexType name="Location">
        <xs:sequence>
          <xs:element name="city" type="xs:string" minOccurs="0"/>
          <xs:element name="latitude" type="tns:Latitude"/>
          <xs:element name="longitude" type="tns:Longitude"/>
        </xs:sequence>
        <xs:attribute name="stationId" type="tns:StationId"/>
      </xs:complexType>

      <xs:complexType name="Conditions">
        <xs:sequence>
          <xs:element name="observedAt" type="xs:dateTime"/>
          <xs:element name="temperature" type="xs:double"/>
          <xs:element name="humidity" type="xs:int" minOccurs="0"/>
          <xs:element name="windSpeed" type="xs:double" minOccurs="0"/>
          <xs:element name="summary" type="xs:string" nillable="true"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="ForecastDay">
        <xs:complexContent>
          <xs:extension base="tns:Conditions">
            <xs:sequence>
              <xs:element name="date" type="xs:date"/>
              <xs:element name="high" type="xs:double"/>
              <xs:element name="low" type="xs:double"/>
              <xs:element name="precipitationChance" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                    <xs:minInclusive value="0"/>
                    <xs:maxInclusive value="100"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>

      <xs:element name="GetCurrentConditions">
        <xs:complexType>
          <xs:sequence>
            <xs:choice>
              <xs:element name="city" type="xs:string"/>
              <xs:element name="stationId" type="tns:StationId"/>
            </xs:choice>
            <xs:element name="units" type="tns:Units" default="metric" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="GetCurrentConditionsResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="location" type="tns:Location"/>
            <xs:element name="conditions" type="tns:Conditions"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="GetForecast">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="latitude" type="tns:Latitude"/>
            <xs:element name="longitude" type="tns:Longitude"/>
            <xs:element name="days" minOccurs="0" default="5">
              <xs:simpleType>
                <xs:restriction base="xs:int">
                  <xs:minInclusive value="1"/>
                  <xs:maxInclusive value="10"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="units" type="tns:Units" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="GetForecastResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="location" type="tns:Location"/>
            <xs:element name="day" type="tns:ForecastDay" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="LocationNotFound">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="query" type="xs:string"/>
            <xs:element name="reason" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>

  <wsdl:message name="GetCurrentConditionsInput">
    <wsdl:part name="parameters" element="tns:GetCurrentConditions"/>
  </wsdl:message>
  <wsdl:message name="GetCurrentConditionsOutput">
    <wsdl:part name="parameters" element="tns:GetCurrentConditionsResponse"/>
  </wsdl:message>
  <wsdl:message name="GetForecastInput">
    <wsdl:part name="parameters" element="tns:GetForecast"/>
  </wsdl:message>
  <wsdl:message name="GetForecastOutput">
    <wsdl:part name="parameters" element="tns:GetForecastResponse"/>
  </wsdl:message>
  <wsdl:message name="LocationNotFoundFault">
    <wsdl:part name="fault" element="tns:LocationNotFound"/>
  </wsdl:message>

  <wsdl:portType name="WeatherPortType">
    <wsdl:operation name="GetCurrentConditions">
      <wsdl:documentation>Latest observed conditions for a city or station.</wsdl:documentation>
      <wsdl:input message="tns:GetCurrentConditionsInput"/>
      <wsdl:output message="tns:GetCurrentConditionsOutput"/>
      <wsdl:fault name="LocationNotFound" message="tns:LocationNotFoundFault"/>
    </wsdl:operation>
    <wsdl:operation name="GetForecast">
      <wsdl:documentation>Daily forecast for coordinates, up to 10 days.</wsdl:documentation>
      <wsdl:input message="tns:GetForecastInput"/>
      <wsdl:output message="tns:GetForecastOutput"/>
      <wsdl:fault name="LocationNotFound" message="tns:LocationNotFoundFault"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="WeatherSoap" type="tns:WeatherPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetCurrentConditions">
      <soap:operation soapAction="http://example.com/weather/v1/GetCurrentConditions"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="LocationNotFound"><soap:fault name="LocationNotFound" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="GetForecast">
      <soap:operation soapAction="http://example.com/weather/v1/GetForecast"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="LocationNotFound"><soap:fault name="LocationNotFound" use="literal"/></wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:binding name="WeatherSoap12" type="tns:WeatherPortType">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetCurrentConditions">
      <soap12:operation soapAction="http://example.com/weather/v1/GetCurrentConditions"/>
      <wsdl:input><soap12:body use="literal"/></wsdl:input>
      <wsdl:output><soap12:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="GetForecast">
      <soap12:operation soapAction="http://example.com/weather/v1/GetForecast"/>
      <wsdl:input><soap12:body use="literal"/></wsdl:input>
      <wsdl:output><soap12:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="WeatherService">
    <wsdl:documentation>Weather lookups.</wsdl:documentation>
    <wsdl:port name="WeatherSoap12" binding="tns:WeatherSoap12">
      <soap12:address location="https://soap.example.com/weather/v1"/>
    </wsdl:port>
    <wsdl:port name="WeatherSoap" binding="tns:WeatherSoap">
      <soap:address location="https://soap.example.com/weather/v1"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
